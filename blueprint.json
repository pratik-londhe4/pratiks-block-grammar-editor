{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Pratiks Block Grammar Editor demo",
		"author": "pratiklondhe"
	},
	"landingPage": "/wp-admin/post.php?post=1&action=edit",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/pratik-londhe4/pratiks-block-grammar-editor",
				"ref": "main"
			},
			"options": {
				"activate": true,
				"targetFolderName": "pratiks-block-grammar-editor"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; wp_set_current_user( 1 ); wp_update_post( array( 'ID' => 1, 'post_title' => 'Block Grammar Editor Demo', 'post_content' => '<!-- wp:paragraph {\"fontSize\":\"medium\",\"style\":{\"typography\":{\"lineHeight\":\"1.8\"}}} -->\\n<p class=\"has-medium-font-size\" style=\"line-height:1.8\">Select this paragraph block, click the three dots in the block toolbar, and choose <strong>Edit Block Grammar</strong>.</p>\\n<!-- /wp:paragraph -->' ) );"
		}
	]
}
